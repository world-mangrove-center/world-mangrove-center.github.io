# ── Database (Neon) ─────────────────────────────────────────────────────────
# Pooled connection string from the Neon console (or set automatically by the
# Vercel ↔ Neon integration). Must include ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Optional: direct (non-pooled) URL, used for migrations when present.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Sessions (admin login) ─────────────────────────────────────────────────
# Long random secret, e.g. `openssl rand -base64 32`. Changing it logs everyone out.
NUXT_APP_SECRET=""

# ── Public site URL (canonical links, hreflang, SEO) ───────────────────────
NUXT_PUBLIC_SITE_URL="https://world-mangrove-center.vercel.app"

# ── First admin user (only read by `npm run db:seed`) ──────────────────────
ADMIN_EMAIL="admin@worldmangrovecenter.org"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# ── Maps ───────────────────────────────────────────────────────────────────
# Google Maps Platform API key with the "Map Tiles API" enabled, used for the
# Google Satellite basemap. Restrict it to your domains (HTTP referrers).
# Leave empty to use Esri World Imagery as the satellite layer.
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
